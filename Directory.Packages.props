<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MsExtVersion Condition="'$(TargetFramework)' != 'net7.0' and '$(TargetFramework)' != 'net6.0'">[10.0.12,)</MsExtVersion>
    <MsExtVersion Condition="'$(TargetFramework)' == 'net7.0' or  '$(TargetFramework)' == 'net6.0'">[6.0,)</MsExtVersion>
    <ReactiveVersion Condition="'$(TargetFramework)' != 'net7.0' and '$(TargetFramework)' != 'net6.0'">[7.0,)</ReactiveVersion>
    <ReactiveVersion Condition="'$(TargetFramework)' == 'net7.0' or  '$(TargetFramework)' == 'net6.0'">[6.0,7.0)</ReactiveVersion>
    <FluidCoreVersion Condition="'$(TargetFramework)' != 'net7.0' and '$(TargetFramework)' != 'net6.0'">[2.40.0,)</FluidCoreVersion>
    <FluidCoreVersion Condition="'$(TargetFramework)' == 'net7.0' or  '$(TargetFramework)' == 'net6.0'">[2.24.0,)</FluidCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Unit Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[17.14.1,18.0)" />
    <PackageVersion Include="xunit.v3" Version="[3.2.2,4.0)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="[3.1.5,4.0)" />
    <PackageVersion Include="coverlet.collector" Version="[3.1.2,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 低版本框架的高版本类型实现 -->
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="[6.0.0,)" />
    <!-- Index/Range -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="[10.0.12,)" />
    <!-- IAsyncXXX -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="[10.0.12,)" />
    <!-- ValueTask -->
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="[4.6.3,)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 低版本框架的高版本语法、特性兼容 -->
    <PackageVersion Include="Meziantou.Polyfill" Version="[1.0.165,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- MS.Ext -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MsExtVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[7.0,)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="[13.0.4,)" />
    <PackageVersion Include="System.IO.Ports" Version="[6.0.0,9.0)" />
    <PackageVersion Include="System.Management" Version="[6.0.0,9.0)" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.183" />
    <PackageVersion Include="System.Memory" Version="[4.6.3,)" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="[6.1.2,)" />
    <PackageVersion Include="Microsoft.CodeAnalysis" Version="[4.5.0,)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[4.5.0,)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="[3.3.4,)" />
    <PackageVersion Include="Portable.BouncyCastle" Version="[1.8.2,)" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="[2.3.1,)" />
    <PackageVersion Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="$(SkiaSharpVersion)" />
    <PackageVersion Include="System.Security.Principal.Windows" Version="[4.4.0,)" />
    <PackageVersion Include="Microsoft.Win32.Registry" Version="[4.4.0,)" />
    <PackageVersion Include="System.Net.Http.WinHttpHandler" Version="[6.0.0,9.0)" />
    <PackageVersion Include="SharpCompress" Version="[0.29.0,0.30)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="[8.0.0, 9.0)" />
    <PackageVersion Include="newbeeui" Version="[9.0.0.1, 12.0)" />
    <PackageVersion Include="Costura.Fody" Version="[6.0.0,)" />
    <PackageVersion Include="FluentBuilder" Version="[0.15.0,0.16)" />
    <PackageVersion Include="BuilderGenerator" Version="[3.1.0,4.0)" />
    <PackageVersion Include="SmartFormat" Version="[3.6.1,4.0)" />
    <PackageVersion Include="Scriban" Version="[7.4,)" />
    <PackageVersion Include="Fluid.Core" Version="$(FluidCoreVersion)" />
    <PackageVersion Include="System.Collections.Immutable" Version="[7.0.0,11.0)" />
    <PackageVersion Include="System.Reactive" Version="$(ReactiveVersion)" />
    <PackageVersion Include="LuaCSharp" Version="[0.5.6,0.6)" />
    <PackageVersion Include="StandardSocketsHttpHandler" Version="[2.2.0.10,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shiny lib -->
    <PackageVersion Include="Shiny.BluetoothLE" Version="$(ShinyVersion)" />
    <PackageVersion Include="Shiny.BluetoothLE.Hosting" Version="$(ShinyVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- AvaloniaUI -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <!-- Avalonia的MVU支持 -->
    <PackageVersion Include="Avalonia.Markup.Declarative" Version="$(AvaloniaVersion)" />
    <!-- Avalonia的主题 -->
    <PackageVersion Include="SukiUI" Version="[7.0.1,8.0)" />
  </ItemGroup>

</Project>
